# 可选：推送到 main 后自动构建并部署到 VPS。
# 用法：复制到 .github/workflows/deploy.yml，并在仓库 Settings → Secrets 配置：
#   VPS_HOST、VPS_USER、VPS_SSH_KEY（私钥）
name: deploy
on:
  push:
    branches: [main]
    paths: ['src/**', 'build.py', 'requirements.txt']
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: '3.12' }
      - run: pip install -r requirements.txt && python3 build.py
      - uses: burnett01/rsync-deployments@7.0.1
        with:
          switches: -az --delete --exclude data/
          path: dist/
          remote_path: /var/www/classfabric/
          remote_host: ${{ secrets.VPS_HOST }}
          remote_user: ${{ secrets.VPS_USER }}
          remote_key: ${{ secrets.VPS_SSH_KEY }}
